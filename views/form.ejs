<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/theme.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a class="navbar-brand" href="/dashboard">🏠 Dashboard</a>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/forms" class="btn btn-sm btn-outline-light">Danh sách Form</a>
                <a href="/submissions" class="btn btn-sm btn-outline-light">Lịch sử nộp</a>
                <% if (user && user.role === 'admin') { %>
                    <a href="/admin/forms" class="btn btn-sm btn-warning">Quản lý Form</a>
                <% } %>
                <a href="/logout" class="btn btn-sm btn-danger">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="mb-3"><%= form.title %></h2>
                <p class="text-muted"><%= form.description %></p>
                <form action="/api/forms/<%= form._id %>/submit" method="POST">
        <% form.fields.sort((a,b)=> (a.order||0)-(b.order||0)).forEach(function(field){ %>
            <div class="mb-3">
                <label class="form-label"><%= field.label %></label>
                <% if(field.type === 'select'){ %>
                    <select name="answers[<%= field._id %>]" class="form-select" <%= field.required ? 'required' : '' %>>
                        <% field.options.forEach(function(opt){ %>
                            <option value="<%= opt %>"><%= opt %></option>
                        <% }) %>
                    </select>
                <% } else { %>
                    <input type="<%= field.type %>" name="answers[<%= field._id %>]" class="form-control" <%= field.required ? 'required' : '' %>>
                <% } %>
            </div>
        <% }) %>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Gửi</button>
                        <a href="/forms" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>