<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/theme.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container">
        <h2 class="mb-4">Các Form đang hoạt động</h2>
        <div class="row">
            <% if (forms && forms.length > 0) { %>
                <% forms.forEach(function(form) { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= form.title %></h5>
                                <p class="card-text text-muted"><%= form.description %></p>
                                <a href="/forms/<%= form._id %>" class="btn btn-primary w-100">Điền Form</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info text-center">Hiện không có form nào đang hoạt động.</div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>