<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết Submission</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/theme.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>
    <div class="container py-4">

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Thông tin Submission</h5>
            </div>
            <div class="card-body">
                <p><strong>Form:</strong> <%= submission.templateId?.title || 'N/A' %></p>
                <p><strong>Người nộp:</strong> <%= submission.employeeId?.username || 'N/A' %> - <%= submission.employeeId?.email || '-' %></p>
                <p><strong>Thời gian nộp:</strong> <%= new Date(submission.submittedAt).toLocaleString('vi-VN') %></p>
                <p>
                    <strong>Trạng thái:</strong>
                    <span class="badge
                        <%= submission.status === 'approved' ? 'bg-success' : '' %>
                        <%= submission.status === 'rejected' ? 'bg-danger' : '' %>
                        <%= submission.status === 'pending' ? 'bg-warning text-dark' : '' %>">
                        <%= submission.status %>
                    </span>
                </p>
            </div>
        </div>

        <% if (successMessage) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Thành công!</strong> <%= successMessage %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Danh sách câu trả lời</h5>
            </div>
            <div class="card-body">
                <% if (submission.answers && submission.answers.length > 0) { %>
                    <ul class="list-group">
                        <% submission.answers.forEach(function(answer) { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong><%= answer.fieldLabel %>:</strong></span>
                                <span><%= answer.value %></span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="text-muted mb-0">Không có dữ liệu trả lời.</p>
                <% } %>
            </div>
        </div>

        <% if (user.role === 'admin') { %>
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Duyệt / Từ chối Submission</h5>
                </div>
                <div class="card-body">
                    <form action="/api/submissions/<%= submission._id %>/status?_method=PUT" method="POST" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Trạng thái mới</label>
                            <select name="status" class="form-select" required>
                                <option value="approved">approved</option>
                                <option value="rejected">rejected</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Ghi chú admin</label>
                            <input type="text" name="adminNote" class="form-control" placeholder="Nhập lý do duyệt/từ chối...">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Cập nhật trạng thái</button>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>