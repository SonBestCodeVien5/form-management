<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/theme.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a class="navbar-brand" href="/admin">👑 Admin Panel</a>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
                <a href="/forms" class="btn btn-sm btn-outline-light">Danh sách Form</a>
                <a href="/submissions" class="btn btn-sm btn-outline-light">Submissions</a>
                <a href="/admin/forms" class="btn btn-sm btn-warning">Quản lý Form</a>
                <a href="/logout" class="btn btn-sm btn-danger">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Quản lý Form</h2>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createFormModal">+ Tạo Form mới</button>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% forms.forEach(function(form) { %>
                            <tr>
                                <td><%= form.title %></td>
                                <td><%= form.description %></td>
                                <td>
                                    <span class="badge <%= form.status === 'active' ? 'bg-success' : 'bg-warning' %>">
                                        <%= form.status %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/admin/forms/<%= form._id %>/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <form action="/api/forms/<%= form._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createFormModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tạo Form mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/admin/forms/create" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tiêu đề</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea name="description" class="form-control" rows="3"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Trạng thái</label>
                            <select name="status" class="form-select">
                                <option value="draft">draft</option>
                                <option value="active">active</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Tạo Form</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>