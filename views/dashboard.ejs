<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Khu vực bảo mật</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Chào mừng đến với Dashboard!</h4>
                        <span class="badge bg-light text-dark">
                            <%= user.role %>
                        </span>
                    </div>
                    <div class="card-body text-center py-5">
                        <h2 class="display-6 mb-4">Xin chào, <strong>
                                <%= user.username %>
                            </strong>!</h2>

                        <div class="alert alert-info border-0 shadow-sm mx-auto mb-4" style="max-width: 400px;">
                            <p class="mb-1">Email: <strong>
                                    <%= user.email %>
                                </strong></p>
                            <p class="mb-0">Trạng thái: <span class="text-success fw-bold">Đã xác thực an toàn</span>
                            </p>
                        </div>

                        <p class="text-muted mb-4">Bạn đang ở trong phiên đăng nhập được bảo vệ bởi hệ thống.</p>

                        <div class="d-grid gap-2 d-md-block">
                            <% if (user.role==='admin' ) { %>
                                <a href="/admin" class="btn btn-primary px-4">Quản trị hệ thống</a>
                                <% } %>
                                    <a href="/logout" class="btn btn-danger px-4">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>