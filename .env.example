PORT=3000

# Dùng cho Docker Compose (MongoDB + App container)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DATABASE=form_management

# Local mode: Node.js chạy trên máy thật, MongoDB map ra cổng 27018
MONGO_URI=mongodb://admin:password123@127.0.0.1:27018/form_management?authSource=admin

# Full Docker mode: Node.js chạy trong Docker Compose
# Không cần tự điền MONGO_URI vì đã được docker-compose.yml tự ghép từ MONGO_ROOT_* ở trên.

SESSION_SECRET=your_super_secret_key_here_change_me_to_something_long_and_random
